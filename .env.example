# Используется при локальном запуске (uv run ...) и в make upgrade.
# В docker compose DB подменяется на сервис db — править не нужно.
DB=postgresql+asyncpg://mosres:mosres@localhost:5434/mosres

# Подпись токенов. Задать один раз и не менять: смена разлогинивает всех.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# Пользователь по умолчанию — заводится контейнером при старте, если такого
# логина ещё нет. Пароль существующего пользователя не перезаписывается,
# меняется через: uv run python -m src.users passwd <логин> <пароль>
DEFAULT_USER=admin
DEFAULT_PASSWORD=admin

SCHEDULER_ENABLED=true
REFRESH_INTERVAL_MINUTES=30
# web host port (docker compose), container always listens on 80
WEB_PORT=8080
